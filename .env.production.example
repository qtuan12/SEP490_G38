# Copy this file to .env.production on the server and fill real values.
# Do not commit .env.production.

FRONTEND_ORIGIN=http://your-domain-or-server-ip
VITE_API_URL=/api

MSSQL_DATABASE=BPGDB
MSSQL_SA_PASSWORD=ChangeThis_Strong_SQL_Password_2026!

JWT_KEY=ChangeThisToAtLeast32Bytes_Long_Random_Production_Key
JWT_ISSUER=BPGConstruction
JWT_AUDIENCE=BPGConstructionClient
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=1

# Set true only when you need Swagger during demo, then turn it off again.
SWAGGER_ENABLED=false

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SENDER_EMAIL=your_email@gmail.com
EMAIL_SENDER_NAME=BPG CMS
EMAIL_PASSWORD=your_app_password
EMAIL_ENABLE_SSL=true
