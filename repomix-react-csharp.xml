                  <th className="px-4 py-3 text-center">Số loại vật tư</th>
                  <th className="px-4 py-3">Ngày xuất</th>
                  <th className="px-4 py-3">Người lập phiếu</th>
                  <th className="px-4 py-3 text-center">Trạng thái</th>
