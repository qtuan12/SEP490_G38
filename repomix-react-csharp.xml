                                    onClick={() => { setPhaseMenuId(null); navigate(`/projects/${projectId}?tab=materialrequests&phaseId=${ph.id}`); }}
                                  >
                                    <FileText size={13} style={{ color: 'hsl(var(--primary))' }} />
