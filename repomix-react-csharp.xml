    for (const file of files) {
      const ext = file.name.split('.').pop()?.toLowerCase();
      if (allowedExtensions.includes(ext || '')) {
        validFiles.push(file);
      } else {
        toast.error(`Tệp ${file.name} không hỗ trợ (chỉ nhận Word, Excel, PDF, tệp nén, ảnh).`);
