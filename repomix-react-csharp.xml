          <AlertCircle size={16} style={{ flexShrink: 0, marginTop: 1 }} />
          <div>
            <div style={{ fontWeight: 600, marginBottom: blockingIssues.length > 1 ? 4 : 0 }}>
              Chưa thể tạo đơn hàng:
