    public List<DelayedTaskInfoDto> DelayedTasksList { get; init; } = new();
    public PeriodComparisonMetricsDto? PeriodComparison { get; init; }
    public List<ProjectComparisonMatrixItemDto> CrossProjectMatrix { get; init; } = new();
