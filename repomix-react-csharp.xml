                }
              />

              <Route 
                path="/users" 
                element={
                  <ProtectedRoute allowedRoles={RoleGroup.AdminOnly}>
                    <UserManagement />
                  </ProtectedRoute>
                } 
              />

              <Route 
                path="/suppliers" 
                element={
                  <ProtectedRoute allowedRoles={RoleGroup.SupplierViewers}>
                    <SupplierManagement />
                  </ProtectedRoute>
                } 
              />

              <Route 
                path="/units" 
                element={
                  <ProtectedRoute allowedRoles={RoleGroup.MasterData}>
                    <UnitManagement />
